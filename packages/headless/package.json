{
	"name": "@tcode/headless",
	"private": true,
	"version": "0.1.0",
	"description": "Headless (no Electron) TCode server for NAS / Docker use, with a clean-room local runtime component",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"build": "node build.mjs",
		"build:release": "node scripts/build-release.mjs",
		"start": "node dist/server.mjs",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"optionalDependencies": {
		"node-pty": "^1.0.0"
	},
	"devDependencies": {
		"@types/web-push": "^3.6.4",
		"esbuild": "^0.25.12",
		"vitest": "^3.2.0"
	},
	"dependencies": {
		"playwright-core": "^1.58.2",
		"web-push": "^3.6.7"
	}
}
