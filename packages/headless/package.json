{
	"name": "@tcode/headless",
	"private": true,
	"version": "0.1.0",
	"description": "Headless (no Electron) TCode server for NAS / Docker use, with a clean-room local runtime component",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"build": "node build.mjs",
		"start": "node dist/server.mjs",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"optionalDependencies": {
		"node-pty": "^1.0.0"
	},
	"devDependencies": {
		"vitest": "^3.2.0",
		"esbuild": "^0.25.12"
	}
}
